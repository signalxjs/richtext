{
    "name": "@sigx/richtext-shiki",
    "version": "0.4.0",
    "description": "Shiki syntax highlighting for @sigx/richtext's DOM view — a lazily-loaded, cached highlighter behind the CodeHighlighter contract, as a plugin",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "richtext",
        "shiki",
        "syntax-highlighting"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/richtext.git",
        "directory": "packages/richtext-shiki"
    },
    "homepage": "https://sigx.dev/richtext/",
    "bugs": {
        "url": "https://github.com/signalxjs/richtext/issues"
    },
    "devDependencies": {
        "@sigx/reactivity": "catalog:",
        "@sigx/richtext": "workspace:*",
        "@sigx/richtext-markdown": "workspace:*",
        "@sigx/runtime-core": "catalog:",
        "@sigx/runtime-dom": "catalog:",
        "@sigx/vite": "catalog:",
        "@types/node": "^26.6.2",
        "shiki": "^4.4.3",
        "sigx": "catalog:",
        "typescript": "^7.0.2",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/reactivity": "^1.0.0",
        "@sigx/richtext": "workspace:^",
        "@sigx/runtime-core": "^1.0.0",
        "@sigx/runtime-dom": "^1.0.0",
        "shiki": ">=3.7.0"
    }
}
