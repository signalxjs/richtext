{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["vite/client", "node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "jsxImportSource": "sigx",
        // The richtext packages resolve from SOURCE, as the root config does, so a
        // clean checkout typechecks before anything is built: the package's
        // own `exports` point at `dist/`, and CI typechecks BEFORE it builds.
        "paths": {
            "@sigx/richtext": ["../../packages/richtext/src/index.ts"],
            "@sigx/richtext/dom": ["../../packages/richtext/src/dom/index.ts"],
            "@sigx/richtext/editor": ["../../packages/richtext/src/editor/index.ts"],
            "@sigx/richtext/editor/dom": ["../../packages/richtext/src/editor/dom/index.ts"],
            "@sigx/richtext/testing": ["../../packages/richtext/src/testing/index.ts"],
            "@sigx/richtext-markdown": ["../../packages/richtext-markdown/src/index.ts"],
            "@sigx/richtext-markdown/editor": ["../../packages/richtext-markdown/src/editor/index.ts"],
            "@sigx/richtext-html": ["../../packages/richtext-html/src/index.ts"],
            "@sigx/richtext-html/editor": ["../../packages/richtext-html/src/editor/index.ts"],
            "@sigx/richtext-shiki": ["../../packages/richtext-shiki/src/index.ts"],
            "@sigx/richtext-zero": ["../../packages/richtext-zero/src/index.ts"],
            "@sigx/richtext-zero/css": ["../../packages/richtext-zero/src/css.d.ts"]
        }
    },
    // `env.d.ts` from the package source declares `__DEV__`, the
    // compile-time flag the bundler replaces — needed because `paths` above
    // compiles that source as part of this program.
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "e2e/**/*.ts",
        "playwright.config.ts",
        "../../packages/richtext/src/env.d.ts"
    ]
}
