{
  "name": "sigx-richtext-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "Rich text for SignalX — a schema-driven mdast-shaped document model with pluggable formats (markdown, HTML), an incremental streaming engine, a renderer-neutral engine with a DOM view, and a block-tree editor for web and Lynx",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "wt": "node scripts/worktree.mjs",
    "branch-protection": "node scripts/apply-branch-protection.mjs",
    "sync:core": "node scripts/sync-core.mjs",
    "verify:catalog": "node scripts/check-catalog.mjs",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit && pnpm --filter playground-example typecheck",
    "lint": "oxlint packages/*/src packages/*/__tests__ examples/playground/src",
    "lint:fix": "oxlint --fix packages/*/src packages/*/__tests__ examples/playground/src",
    "clean": "rm -rf packages/*/dist packages/*/node_modules examples/*/dist examples/*/node_modules node_modules",
    "publish:dry": "node scripts/publish.js --dry-run",
    "publish:all": "node scripts/publish.js",
    "publish:beta": "node scripts/publish.js --tag beta",
    "version:set": "node scripts/bump-version.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "verify:pack": "node scripts/verify-pack.js",
    "size": "size-limit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^11",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "oxlint": "^1.85.0",
    "size-limit": "^11",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "SignalX",
    "sigx",
    "richtext",
    "markdown",
    "mdast",
    "commonmark",
    "gfm",
    "streaming",
    "editor",
    "lynx"
  ],
  "author": "Andreas Ekdahl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalxjs/richtext.git"
  },
  "homepage": "https://sigx.dev/richtext/",
  "bugs": {
    "url": "https://github.com/signalxjs/richtext/issues"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
