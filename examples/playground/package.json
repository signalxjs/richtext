{
    "name": "playground-example",
    "private": true,
    "type": "module",
    "description": "The Richtext Lab: @sigx/richtext with no design system — token-by-token streaming through its own incremental engine with the final / open block state marked, an engine inspector, the serializers, the round trip and the core editor",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview --port 4173 --strictPort",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@sigx/richtext": "workspace:*",
        "@sigx/richtext-html": "workspace:*",
        "@sigx/richtext-markdown": "workspace:*",
        "@sigx/richtext-shiki": "workspace:*",
        "shiki": "^4.0.2",
        "sigx": "catalog:"
    },
    "devDependencies": {
        "@sigx/vite": "catalog:",
        "@types/node": "^26.6.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.1"
    }
}
