{
    "name": "@sigx/richtext-zero",
    "version": "0.5.0",
    "description": "A finished rich text editor for @sigx/richtext, drawn with @sigx/zero components — toolbar with icons, floating toolbar, slash menu, link popover, rich / split / source views — styled by whichever @sigx/zero-* design system the app loads",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        },
        "./css": {
            "types": "./dist/css.d.ts",
            "default": "./dist/richtext-zero.css"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly && node -e \"for (const f of ['richtext-zero.css', 'css.d.ts']) require('fs').copyFileSync('src/' + f, 'dist/' + f)\"",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "richtext",
        "editor",
        "zero",
        "design-system"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/richtext.git",
        "directory": "packages/richtext-zero"
    },
    "homepage": "https://sigx.dev/richtext/",
    "bugs": {
        "url": "https://github.com/signalxjs/richtext/issues"
    },
    "devDependencies": {
        "@sigx/reactivity": "catalog:",
        "@sigx/richtext": "workspace:*",
        "@sigx/richtext-html": "workspace:*",
        "@sigx/richtext-markdown": "workspace:*",
        "@sigx/runtime-core": "catalog:",
        "@sigx/runtime-dom": "catalog:",
        "@sigx/vite": "catalog:",
        "@sigx/zero": "catalog:",
        "@types/node": "^26.6.2",
        "sigx": "catalog:",
        "typescript": "^7.0.2",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/reactivity": "^1.0.0",
        "@sigx/richtext": "workspace:^",
        "@sigx/runtime-core": "^1.0.0",
        "@sigx/runtime-dom": "^1.0.0",
        "@sigx/zero": "^0.15.0",
        "sigx": "^1.0.0"
    }
}
