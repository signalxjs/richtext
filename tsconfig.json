{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "sigx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@sigx/richtext": [
        "./packages/richtext/src/index.ts"
      ],
      "@sigx/richtext/dom": [
        "./packages/richtext/src/dom/index.ts"
      ],
      "@sigx/richtext/editor": [
        "./packages/richtext/src/editor/index.ts"
      ],
      "@sigx/richtext/editor/dom": [
        "./packages/richtext/src/editor/dom/index.ts"
      ],
      "@sigx/richtext/testing": [
        "./packages/richtext/src/testing/index.ts"
      ],
      "@sigx/richtext-markdown": [
        "./packages/richtext-markdown/src/index.ts"
      ],
      "@sigx/richtext-markdown/editor": [
        "./packages/richtext-markdown/src/editor/index.ts"
      ],
      "@sigx/richtext-zero": [
        "./packages/richtext-zero/src/index.ts"
      ],
      "@sigx/richtext-shiki": [
        "./packages/richtext-shiki/src/index.ts"
      ],
      "@sigx/richtext-html": [
        "./packages/richtext-html/src/index.ts"
      ],
      "@sigx/richtext-html/editor": [
        "./packages/richtext-html/src/editor/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/__tests__/**/*.ts",
    "packages/*/__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/dist",
    "examples"
  ]
}
